# ── Telegram ─────────────────────────────────────────────────────────────
# Create a bot with @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# Your own Telegram numeric user ID(s), comma-separated. The bot DMs you here
# when a hot lead comes in. Get your ID from @userinfobot.
SELLER_CHAT_IDS=

# ── Ollama (on your droplet) ─────────────────────────────────────────────
# If the bot runs on the SAME droplet as Ollama, keep localhost.
# If it runs elsewhere, use http://YOUR_DROPLET_IP:11434 and make sure
# Ollama is exposed (see README) — ideally behind a firewall/VPN.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Generation controls
OLLAMA_TEMPERATURE=0.6
OLLAMA_NUM_CTX=4096
# Seconds before giving up on a slow response
OLLAMA_TIMEOUT=120

# ── LLM backend (choose the engine per client) ───────────────────────────
# "ollama" (default) uses the local Ollama above.
# "openai" uses ANY OpenAI-compatible API — OpenRouter, Together, DeepInfra,
# Fireworks, Novita, a vLLM box, etc. This is how you run cheaply at volume and
# how you reach uncensored open models (pick a provider whose policy allows it).
LLM_BACKEND=ollama
# For LLM_BACKEND=openai — the provider's base URL, key, and model slug:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=<provider's model id>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Max tokens per reply (keeps replies short + costs down).
LLM_MAX_TOKENS=512

# ── Instagram / Messenger DM front-end (optional) ────────────────────────
# Lets the SAME engine answer Instagram/Facebook DMs. Meta pushes DMs to a
# public HTTPS webhook, so this needs a domain + TLS (unlike Telegram).
# Requires: IG Professional account + linked FB Page + a Meta app with
# Instagram messaging permissions + Meta App Review. Run with:  python run.py instagram
# A token YOU invent; you paste the same value into Meta's webhook config.
META_VERIFY_TOKEN=
# From your Meta app (used to validate incoming webhook signatures).
META_APP_SECRET=
# Page/IG access token used to send replies.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# Where the webhook server listens (put a reverse proxy / TLS in front).
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ── Web storefront (your own site) ───────────────────────────────────────
# A mobile chat + one-tap Stripe checkout + instant PDF delivery, no login.
# Run with:  python run.py web   (put nginx/Caddy + TLS in front)
# Your public https base URL (used for success + download links).
STORE_PUBLIC_URL=https://shop.yourdomain.com
# Stripe webhook signing secret (whsec_…) from the Stripe Dashboard → Webhooks.
# Point the webhook at:  https://shop.yourdomain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── Business ─────────────────────────────────────────────────────────────
BUSINESS_NAME=Your Business
# Optional: a checkout / payment link the bot can send when a buyer is ready.
# Leave blank to have the bot just hand the lead to you instead.
CHECKOUT_URL=

# Per-client product catalog (each client bot points to its own file).
CATALOG_PATH=catalog.json

# Where leads/orders/inventory are stored (SQLite file — one per client bot).
DATABASE_PATH=data/leads.db

# ── Persona / human-like chatting ────────────────────────────────────────
# A first name makes it feel like a real person. Leave blank for no name.
PERSONA_NAME=
# Optional extra personality notes fed to the model. The default voice is
# already conversational, low-key, a little skeptical, and lets the buyer chase
# (not salesy). Use this to add flavor or dial it, e.g.
# "You're laid-back, use a bit of slang, and you're a sneaker nerd."
# "Even more selective — make them really prove they're serious before you bite."
PERSONA_STYLE=
# Humanize replies: split into short chat bubbles with realistic typing delays,
# and strip markdown. Set false for plain instant single-message replies.
HUMANIZE=true
# Typing speed (characters/second) — lower = longer, more human "typing…" pauses.
TYPING_CPS=18
# Max number of chat bubbles per reply.
MAX_BUBBLES=3

# ── Compliance (bot disclosure + terms) ──────────────────────────────────
# Show a one-time "you're chatting with an automated assistant" notice at the
# start of each conversation. Keeps you onside with bot-disclosure laws (e.g.
# California SB 1001) and lowers chargeback risk. Recommended: true.
DISCLOSURE_ENABLED=true
# The notice text. {business} is replaced with BUSINESS_NAME.
DISCLOSURE_TEXT=heads up — you're chatting with an automated assistant for {business}. i can still get you sorted. type /terms anytime for the refund policy.
# Shown by the /terms command. Payment processors (Stripe) expect a visible
# refund policy and a way to reach you. Customize for your business.
REFUND_POLICY=All sales are final once your item is delivered, unless it's defective or you never received it — in that case you get a full refund. Just reach out and we'll sort it out.
# How customers reach a human for support/disputes (email, @handle, etc.).
SUPPORT_CONTACT=
# Optional link to full terms of service.
TERMS_URL=

# ── Abuse protection (bot is public — anyone can message it) ──────────────
# Max messages per user per minute before they're throttled. Protects Ollama
# (and your other client bots) from floods. Lower = stricter.
RATE_LIMIT_PER_MIN=15
# Max characters accepted per message (longer is truncated). Guards the model
# context window and compute cost against giant pasted text.
MAX_INPUT_CHARS=1000

# ── Autonomous checkout (Stripe and/or PayPal) ───────────────────────────
# RECOMMENDED for 100% hands-off selling. Set either/both processors below and
# the bot uses hosted checkout, verifies payment by polling the processor's API
# (no webhook/domain needed), then delivers a unique item from inventory.
#   Stripe → cards, Apple Pay, Google Pay, Cash App Pay
#   PayPal → PayPal + Venmo   (Venmo shows for eligible US mobile buyers)
# If two are set, the buyer picks which at checkout. These take priority over
# the PAYMENT_PROVIDERS flow below.
#
# —— Stripe ——
# Get your key at https://dashboard.stripe.com/apikeys  (sk_live_… or sk_test_…)
# Get your key at https://dashboard.stripe.com/apikeys  (sk_live_… or sk_test_…)
STRIPE_SECRET_KEY=
# Where Stripe sends the customer after paying / cancelling. Any https URL works;
# https://t.me returns them to Telegram. Optional.
STRIPE_SUCCESS_URL=https://t.me
STRIPE_CANCEL_URL=https://t.me
# Payment methods to offer on the checkout page (comma-separated).
# card also enables Apple Pay / Google Pay automatically on supported devices.
STRIPE_PAYMENT_METHODS=card,cashapp
# How often (seconds) to poll Stripe for payment, and how long a checkout link
# stays valid before it's expired.
STRIPE_POLL_INTERVAL=8
STRIPE_SESSION_TIMEOUT=1800

# —— PayPal + Venmo ——
# Create REST API credentials at https://developer.paypal.com/dashboard/applications
# Setting client id + secret turns on autonomous PayPal + Venmo checkout.
PAYPAL_ENV=live               # live | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Where PayPal returns the buyer after paying / cancelling (any https URL).
PAYPAL_RETURN_URL=https://t.me
PAYPAL_CANCEL_URL=https://t.me
# Offer Venmo inside PayPal checkout (only appears for eligible US mobile buyers).
PAYPAL_ENABLE_VENMO=true

# ── Manual payment providers (used only if NO processor above is set) ─────
# Which payment methods to offer, comma-separated. Leave blank to disable the
# whole payment/verification flow (bot just hands leads to you).
# Supported: paypal, cashapp, applepay, venmo
PAYMENT_PROVIDERS=
# Your paypal.me handle for the manual flow. Optional.
PAYPAL_ME=

# — Cash App (verifiable ONLY via a Square merchant account: Cash App Pay) —
# Get an access token at https://developer.squareup.com/apps
# If you leave this blank, Cash App payments are HUMAN-verified (you approve).
SQUARE_ENV=production         # production | sandbox
SQUARE_ACCESS_TOKEN=
# Your $cashtag, shown to customers in pay instructions. Optional.
CASHAPP_CASHTAG=

# — Apple Pay (verified through a processor; here: Square, above) —
# Apple Pay is a card wallet, not a P2P app — it needs a processor. It reuses
# your SQUARE_ACCESS_TOKEN above. Give customers a Square payment link / hosted
# checkout that offers Apple Pay; they then send you the Square Payment ID.
# Falls back to APPLEPAY_LINK, then CHECKOUT_URL, then human review.
# (Apple *Cash* — the iMessage P2P transfer — has no API and can't be auto-verified.)
APPLEPAY_LINK=

# — Venmo (NO public verification API for personal accounts) —
# Venmo payments are always HUMAN-verified (you approve in Telegram).
# Your Venmo handle, shown to customers. Optional.
VENMO_HANDLE=
